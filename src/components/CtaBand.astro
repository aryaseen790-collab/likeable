---
import { t, lpath, DEFAULT_LANG } from '../lib/i18n';
const { lang = DEFAULT_LANG } = Astro.props as { lang?: string };
---
<section class="container section" style="padding-bottom:0">
  <div class="cta-band" data-reveal>
    <span class="eyebrow">{t(lang, 'cta.eyebrow')}</span>
    <h2>{t(lang, 'cta.title')}</h2>
    <p>{t(lang, 'cta.text')}</p>
    <a class="btn btn--primary btn--lg" href={`${lpath(lang, '/')}#take-test`}>{t(lang, 'cta.button')}</a>
  </div>
</section>
