---
import Base from '../../layouts/Base.astro';
import '../../styles/home.css';
import PostCard from '../PostCard.astro';
import { home, site, dimensions, paginate } from '../../lib/data';
import { sectionToTopics, parseFaq, parseCta } from '../../lib/topics';
import { t, lpath, homeIn, postIn, blogPostsIn, langOf, DEFAULT_LANG } from '../../lib/i18n';

interface Props { lang: string }
const { lang } = Astro.props;
const T = (k: string, v?: Record<string, string | number>) => t(lang, k, v);
const L = (p: string) => lpath(lang, p);
const sections = homeIn(lang);
const byCls = (cls: string) => sections.find((s) => s.cls === cls)!;
const topics = ['lpt-what-section', 'lpt-likable-section', 'lpt-social-section', 'lpt-unlikable-section', 'lpt-personality-section', 'lpt-popular-section', 'lpt-tips-section'].flatMap(
  (cls) => sectionToTopics(byCls(cls).html),
);
const faq = parseFaq(byCls('lpt-faq-section').html);
const cta = parseCta(byCls('lpt-cta-section').html);
const icons = dimensions().map((d) => d.icon);
const dims = icons.map((icon, i) => ({ icon, name: T(`dim.${i}.name`), desc: T(`dim.${i}.desc`) }));
const colors = ['#22b8e6', '#4f73ff', '#f5b301', '#ec4899', '#8b5cf6', '#10b981', '#3b82f6', '#f76a0c', '#d946ef'];
// Until posts are translated, the blog section lists the English articles.
const blogLang = lang;
const [blogPage] = paginate(blogPostsIn(blogLang), site.homePerPage);
const steps = [
  { icon: '📝', title: T('how.s1title'), text: T('how.s1text') },
  { icon: '🪐', title: T('how.s2title'), text: T('how.s2text') },
  { icon: '📊', title: T('how.s3title'), text: T('how.s3text') },
];
const strip = (s: string) => s.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
// English keeps the imported structured data; translations get their own.
const schema =
  lang === DEFAULT_LANG
    ? home.schema
    : [
        JSON.stringify({
          '@context': 'https://schema.org',
          '@graph': [
            { '@type': ['WebApplication', 'Quiz'], name: strip(T('test.barTitle')), description: T('hero.subtitle'), url: `${site.origin}${L('/')}`, inLanguage: langOf(lang).tag, applicationCategory: 'EducationalApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
            {
              '@type': 'FAQPage',
              inLanguage: langOf(lang).tag,
              mainEntity: faq.items.map((d) => {
                const m = d.match(/<summary>([\s\S]*?)<\/summary><div class="faq-a">([\s\S]*)<\/div><\/details>/);
                return { '@type': 'Question', name: strip(m?.[1] ?? ''), acceptedAnswer: { '@type': 'Answer', text: strip(m?.[2] ?? '') } };
              }),
            },
          ],
        }),
      ];
---
<Base path={L('/')} enPath="/" lang={lang} title={T('meta.homeTitle')} description={T('meta.homeDescription')} schema={schema} bodyClass="home">
  <!-- HERO + TEST: the quiz sits in the first screen so visitors can start straight away -->
  <section class="hero" data-quiz-state="start">
    <div class="container hero__grid">
      <div class="hero__intro">
        <div class="chip"><span class="chip-dot"></span>{T('hero.badge')}</div>
        <h1 class="display hero__title" set:html={T('hero.title')} />
      </div>
      <div class="hero__more">
        <p class="lead hero__sub">{T('hero.subtitle')}</p>
        <dl class="hero__stats">
          <div><dd><span data-count="25">25</span></dd><dt>{T('hero.statQuestions')}</dt></div>
          <div><dd><span data-count="9">9</span></dd><dt>{T('hero.statCategories')}</dt></div>
          <div><dd><span data-count="5">5</span> {T('hero.minutes')}</dd><dt>{T('hero.statTime')}</dt></div>
        </dl>
        <a href={`${L('/')}#what-makes`} class="hero__learn">{T('hero.learnMore')} <span aria-hidden="true">→</span></a>
      </div>
      <div class="hero__test">
        <div class="quiz card" id="take-test" data-quiz data-state="start" data-lang={lang}>
          <div class="quiz__bar">
            <h2 class="quiz__title">{T('test.barTitle')}</h2>
            <p>{T('test.barText')}</p>
          </div>

          <div class="quiz__start" data-step="start">
            <div class="quiz__start-emojis" aria-hidden="true">{dims.map((d) => <span>{d.icon}</span>)}</div>
            <p class="quiz__start-hook">{T('test.hook')}</p>
            <p class="quiz__start-desc">{T('test.desc')}</p>
            <div class="quiz__start-actions">
              <button type="button" class="btn btn--primary btn--lg" data-action="start">{T('test.start')}</button>
              <button type="button" class="btn btn--ghost" data-action="resume" data-resume hidden>{T('test.resume', { n: '', total: 25 })}</button>
            </div>
            <ul class="quiz__perks">
              <li>{T('test.perkPrivate')}</li>
              <li>{T('test.perkKeys')}</li>
              <li>{T('test.perkReport')}</li>
            </ul>
          </div>

          <div class="quiz__run" data-step="run" hidden>
            <div class="quiz__main">
              <div class="quiz__top">
                <div class="quiz__ring" data-ring aria-hidden="true"><svg viewBox="0 0 44 44"><circle cx="22" cy="22" r="19" /><circle cx="22" cy="22" r="19" /></svg></div>
                <p class="quiz__count"><b data-current>1</b> {T('test.of')} <span data-total>25</span></p>
                <span class="quiz__cat" data-cat></span>
              </div>
              <div class="quiz__card" data-card aria-live="polite">
                <p class="quiz__hook" data-hook></p>
                <h3 class="quiz__q" id="quiz-q" data-q></h3>
                <div class="quiz__options" role="radiogroup" aria-labelledby="quiz-q" data-options></div>
              </div>
              <div class="quiz__nav">
                <button type="button" class="btn btn--ghost btn--sm" data-action="prev" data-prev>{T('test.previous')}</button>
                <ol class="quiz__dims" data-dims aria-hidden="true"></ol>
                <button type="button" class="btn btn--primary btn--sm" data-action="next" data-next>{T('test.next')}</button>
              </div>
            </div>
            <div class="orbit-panel orbit-panel--quiz" data-orbit-slot="quiz" aria-hidden="true"><canvas class="orbit-canvas" data-orbit aria-hidden="true"></canvas></div>
          </div>

          <div class="quiz__result" data-step="result" hidden>
            <p class="quiz__shared">{T('test.shared')} <button type="button" class="linklike" data-action="retry">{T('test.takeYourself')}</button></p>
            <h2 class="quiz__result-title">{T('test.resultsTitle')}</h2>
            <div class="result-hero">
              <div class="score-ring" data-score-ring>
                <svg viewBox="0 0 120 120" aria-hidden="true"><defs><linearGradient id="scoreGrad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#22b8e6" /><stop offset=".5" stop-color="#7c4dff" /><stop offset="1" stop-color="#f76a0c" /></linearGradient></defs><circle cx="60" cy="60" r="52" /><circle cx="60" cy="60" r="52" /></svg>
                <div class="score-ring__value"><span data-overall>0%</span><small data-label></small></div>
              </div>
              <div class="result-hero__text">
                <div class="lpt-overall-feedback" data-feedback></div>
                <div class="result-highlights">
                  <div class="result-highlight result-highlight--top"><span>{T('test.topStrength')}</span><p data-strength></p></div>
                  <div class="result-highlight result-highlight--focus"><span>{T('test.focusArea')}</span><p data-focus></p></div>
                </div>
              </div>
              <div class="orbit-panel orbit-panel--result" data-orbit-slot="result" aria-hidden="true"></div>
            </div>
            <div class="result-body">
              <div class="radar card" data-radar></div>
              <div class="lpt-categories-grid" data-grid></div>
            </div>
            <div class="lpt-action-buttons">
              <button type="button" class="btn btn--primary" data-action="share">{T('test.share')}</button>
              <button type="button" class="btn" data-action="copy">{T('test.copy')}</button>
              <button type="button" class="btn" data-action="download">{T('test.download')}</button>
              <button type="button" class="btn" data-action="retry">{T('test.retry')}</button>
            </div>
            <p class="quiz__share-msg" data-share-msg role="status"></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => dims.map((d) => <span class="marquee__item">{d.icon} {d.name}</span>))}
    </div>
  </div>

  <!-- HOW IT WORKS -->
  <section class="section how" id="how">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <span class="eyebrow">{T('how.eyebrow')}</span>
        <h2 class="h2" set:html={T('how.title')} />
      </div>
      <div class="how__grid">
        {steps.map((s, i) => (
          <article class="how-card card" data-reveal data-tilt>
            <span class="how-card__icon" aria-hidden="true">{s.icon}</span>
            <span class="how-card__n">{T('how.step', { n: i + 1 })}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- NINE DIMENSIONS -->
  <section class="section dims">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">{T('dims.eyebrow')}</span>
        <h2 class="h2" set:html={T('dims.title')} />
      </div>
      <div class="dims__grid">
        {dims.map((d, i) => (
          <article class="dim-card card" style={`--c:${colors[i]}`} data-n={String(i + 1).padStart(2, '0')} data-reveal data-tilt>
            <span class="dim-card__icon" aria-hidden="true">{d.icon}</span>
            <h3>{d.name}</h3>
            <p>{d.desc}</p>
          </article>
        ))}
      </div>
      <a class="dims__guide" href={postIn(lang, 'complete-guide') ? L('/complete-guide/') : '/complete-guide/'} data-reveal>
        <span aria-hidden="true">📘</span>
        <span set:html={T('dims.guide')} />
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- KNOWLEDGE TOPICS (original home content, bento layout) -->
  <section class="section learn" aria-label={T('learn.aria')}>
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <span class="eyebrow">{T('learn.eyebrow')}</span>
        <h2 class="h2" set:html={T('learn.title')} />
      </div>
      <nav class="topic-nav" aria-label={T('learn.topics')} data-toc>
        {topics.filter((t) => t.label).map((t) => <a href={`#${t.id}`}>{t.label}</a>)}
      </nav>
      {topics.map((t) => (
        <article class="topic" id={t.id}>
          <header class="topic__head" data-reveal>
            {t.label && <span class="eyebrow">{t.label}</span>}
            {t.titleHtml && <h2 class="topic__title" id={t.headingId} set:html={t.titleHtml} />}
            {t.intro.length > 0 && <div class="topic__intro">{t.intro.map((p) => <p set:html={p} />)}</div>}
          </header>
          <div class="bento">
            {t.tiles.map((tile) =>
              tile.kind === 'image' ? (
                <figure class="tile tile--image" data-reveal set:html={tile.html} />
              ) : tile.kind === 'cards' ? (
                <div class={`tile tile--cards tile--${tile.variant}`} data-reveal set:html={tile.html} />
              ) : tile.kind === 'quote' ? (
                <blockquote class="tile tile--quote" data-reveal set:html={tile.html} />
              ) : (
                <div class:list={['tile tile--text', { 'tile--wide': tile.wide }]} data-reveal>
                  {tile.eyebrow && <span class="eyebrow">{tile.eyebrow}</span>}
                  {tile.title && <h3 id={tile.id} set:html={tile.title} />}
                  <Fragment set:html={tile.html} />
                </div>
              ),
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- BLOG -->
  <section class="section home-blog">
    <div class="container">
      <div class="home-blog__head" data-reveal>
        <div>
          <span class="eyebrow">{T('blog.eyebrow')}</span>
          <h2 class="h2">{lang === DEFAULT_LANG ? home.blog.heading || 'Our Blog' : T('blog.heading')}</h2>
        </div>
        <a class="btn" href={lpath(blogLang, '/blog/')}>{T('blog.all')}</a>
      </div>
      <div class="post-grid">
        {blogPage.items.map((p, i) => <PostCard post={p} lang={blogLang} feature={i === 0} />)}
      </div>
      {lang === DEFAULT_LANG && blogPage.total > 1 && (
        <nav class="pagination" aria-label={T('pagination.label')}>
          <span aria-current="page">1</span>
          {Array.from({ length: blogPage.total - 1 }, (_, i) => i + 2).map((n) => <a href={`/page/${n}/`}>{n}</a>)}
          <a href="/page/2/" rel="next">{T('pagination.next')}</a>
        </nav>
      )}
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq" id="faq">
    <div class="container faq__grid">
      <div class="faq__intro" data-reveal>
        <span class="eyebrow">{faq.label || 'FAQ'}</span>
        <h2 class="h2" id={faq.titleId} set:html={faq.titleHtml} />
        {faq.intro.map((p) => <p class="lead" set:html={p} />)}
        {faq.image && <div class="faq__image" set:html={faq.image} />}
      </div>
      <div class="faq-list">{faq.items.map((d) => <Fragment set:html={d} />)}</div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="container">
    <div class="cta-band" data-reveal>
      <span class="eyebrow">{T('cta.eyebrow')}</span>
      <h2 id={cta.titleId} set:html={cta.titleHtml} />
      <p set:html={cta.text} />
      <a class="btn btn--lg" href={`${L('/')}#take-test`}>{cta.cta.label}</a>
    </div>
  </section>

  <script>
    import { initHome } from '../../scripts/home';
    initHome();
  </script>
</Base>
