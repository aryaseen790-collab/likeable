---
import type { TocItem } from '../lib/data';
const { items, title = 'Table of Contents' } = Astro.props as { items: TocItem[]; title?: string };
---
<nav class="toc glass" aria-label={title} data-toc>
  <div class="toc__title">{title}</div>
  <ol>
    {items.map((t) => <li class={`lvl-${t.level}`}><a href={`#${t.id}`} set:html={t.text} /></li>)}
  </ol>
</nav>
