---
import Base from '../layouts/Base.astro';
import PostCard from './PostCard.astro';
import CtaBand from './CtaBand.astro';
import type { Post } from '../lib/data';
import { t, lpath, DEFAULT_LANG } from '../lib/i18n';
interface Props { path: string; enPath?: string; lang?: string; eyebrow: string; title: string; metaTitle?: string; intro?: string; items: Post[]; page?: number; total?: number; base?: string; featureFirst?: boolean }
const { path, enPath = path, lang = DEFAULT_LANG, eyebrow, title, metaTitle, intro, items, page = 1, total = 1, base = '', featureFirst = false } = Astro.props;
const T = (k: string) => t(lang, k);
const href = (n: number) => lpath(lang, n === 1 ? `${base}/` : `${base}/page/${n}/`);
---
<Base path={path} enPath={enPath} lang={lang} title={metaTitle ?? title.replace(/<[^>]+>/g, '')} description={intro}>
  <section class="archive-hero container">
    <div data-reveal>
      <span class="eyebrow">{eyebrow}</span>
      <h1 class="display" set:html={title} />
      {intro && <p class="lead">{intro}</p>}
    </div>
  </section>
  <section class="container">
    <div class="post-grid">
      {items.map((p, i) => <PostCard post={p} lang={lang} feature={featureFirst && i === 0 && page === 1} eager={i < 2} />)}
    </div>
    {total > 1 && (
      <nav class="pagination" aria-label={T('pagination.label')}>
        {page > 1 && <a href={href(page - 1)} rel="prev">{T('pagination.previous')}</a>}
        {Array.from({ length: total }, (_, i) => i + 1).map((n) => (n === page ? <span aria-current="page">{n}</span> : <a href={href(n)}>{n}</a>))}
        {page < total && <a href={href(page + 1)} rel="next">{T('pagination.next')}</a>}
      </nav>
    )}
  </section>
  <CtaBand lang={lang} />
</Base>
