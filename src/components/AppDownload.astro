---
// "Get the Android app": a direct APK download from GitHub Releases. Only rendered
// when a release exists; hidden on iPhone/iPad, where APKs can't be installed.
import { t, lpath, DEFAULT_LANG } from '../lib/i18n';
import { appRelease, androidVersion, megabytes } from '../lib/app-release';
const { lang = DEFAULT_LANG } = Astro.props as { lang?: string };
const T = (k: string, v?: Record<string, string | number>) => t(lang, k, v);
const rel = appRelease();
const size = rel ? Number(megabytes(rel.size)).toLocaleString(lang, { maximumFractionDigits: 1 }) : '';
---
{rel && (
  <section class="section app-dl" id="get-app" data-app-download>
    <div class="container">
      <div class="app-dl__card card" data-reveal>
        <div class="app-dl__icon" aria-hidden="true">📱</div>
        <div class="app-dl__body">
          <span class="eyebrow">{T('app.eyebrow')}</span>
          <h2 class="h2">{T('app.title')}</h2>
          <p>{T('app.text')}</p>
          <div class="app-dl__actions">
            <a class="btn btn--primary btn--lg" href={rel.url} type="application/vnd.android.package-archive" data-app-apk>
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12M7 10l5 5 5-5M5 21h14" /></svg>
              {T('app.download')}
            </a>
            <p class="app-dl__meta">{T('app.meta', { version: rel.version, size, android: androidVersion(rel.minSdk) })}</p>
            <a class="app-dl__more" href={lpath(lang, '/app/')}>{T('app.learnMore')} <span aria-hidden="true">→</span></a>
          </div>
          <details class="app-dl__how">
            <summary>{T('app.howTitle')}</summary>
            <ol>
              <li>{T('app.how1')}</li>
              <li>{T('app.how2')}</li>
              <li>{T('app.how3')}</li>
            </ol>
            <p class="app-dl__note">{T('app.safety')}</p>
            <p class="app-dl__sha"><span>SHA-256</span> <code>{rel.sha256}</code></p>
          </details>
        </div>
      </div>
    </div>
  </section>
)}
<script>
  // Hidden on iPhone/iPad by the script in Footer.astro.
  document.querySelector('[data-app-apk]')?.addEventListener('click', () => (window as any).gtag?.('event', 'app_download', { platform: 'android' }));
</script>
<style>
  .app-dl__card { display: flex; gap: clamp(20px, 4vw, 40px); align-items: flex-start; padding: clamp(24px, 5vw, 48px); }
  .app-dl__icon { font-size: clamp(44px, 8vw, 72px); line-height: 1; flex: none; }
  .app-dl__body { display: grid; gap: 14px; min-width: 0; }
  .app-dl__body > p { color: var(--text-2); max-width: 62ch; }
  .app-dl__actions { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; }
  .app-dl__actions .btn { gap: 10px; }
  .app-dl__meta { color: var(--muted); font-size: 0.95rem; }
  .app-dl__more { font-weight: 600; }
  .app-dl__how summary { cursor: pointer; font-weight: 600; color: var(--accent); min-height: 44px; display: flex; align-items: center; }
  .app-dl__how ol { padding-inline-start: 1.3em; display: grid; gap: 6px; color: var(--text-2); }
  .app-dl__note { margin-top: 10px; color: var(--text-2); }
  .app-dl__sha { margin-top: 8px; font-size: 0.85rem; color: var(--muted); overflow-wrap: anywhere; }
  .app-dl__sha code { font-size: 0.8rem; }
  @media (max-width: 620px) { .app-dl__card { flex-direction: column; } }
</style>
