---
import { site } from '../lib/data';
import { t, lpath, langOf, liveLangs, alternates as altsOf, type Lang } from '../lib/i18n';
interface Props { path: string; enPath: string; lang: string; alternates: { lang: Lang; href: string }[] }
const { enPath, lang, alternates } = Astro.props;
const T = (k: string) => t(lang, k);
// Nav targets exist in a language only if translated; otherwise link the English page.
const navKey: Record<string, string> = { '/complete-guide/': 'nav.guide', '/likeable-person-test-results/': 'nav.results', '/blog/': 'nav.blog', '/privacy-policy/': 'nav.privacy', '/terms-conditions/': 'nav.terms' };
const nav = site.nav.map((item) => {
  const translated = lang === 'en' || altsOf(item.href).some((a) => a.lang.code === lang);
  return { label: T(navKey[item.href] ?? item.label), href: translated ? lpath(lang, item.href) : item.href, enHref: item.href };
});
const isActive = (enHref: string) => enPath === enHref || (enHref === '/blog/' && enPath.startsWith('/blog/'));
const current = langOf(lang);
const home = lpath(lang, '/');
const ctaHref = `${home}#take-test`;
// Language switcher: every live language — this page where it is translated,
// otherwise that language's home page.
const switcher = liveLangs().map((l) => alternates.find((a) => a.lang.code === l.code) ?? { lang: l, href: lpath(l.code, '/') });
---
<header class="site-header" data-header>
  <div class="site-header__inner">
    <a href={home} class="brand" aria-label={`${site.name} — ${T('nav.home')}`}>
      <img src="/wp-content/uploads/2025/12/cropped-Likabke-Person-Test-Online-Icon-180x180.png" alt="" width="38" height="38" />
      <span class="brand__word">Likeable Person<br /><b>Test Online</b></span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <ul id="primary-menu">
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.enHref) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <details class="lang-switch" data-lang-switch>
      <summary aria-label={T('nav.language')}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
        <span>{current.code.toUpperCase()}</span>
      </summary>
      <ul>
        {switcher.map((a) => (
          <li><a href={a.href} hreflang={a.lang.tag} lang={a.lang.tag} aria-current={a.lang.code === lang ? 'true' : undefined}>{a.lang.name}</a></li>
        ))}
      </ul>
    </details>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label={T('theme.toDark')} data-label-dark={T('theme.toDark')} data-label-light={T('theme.toLight')}>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    </button>
    <a href={ctaHref} class="btn btn--primary btn--sm site-header__cta">{T('nav.cta')}</a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="sr-only">{T('nav.menu')}</span><span class="menu-toggle__bars" aria-hidden="true"></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul>
      {nav.map((item) => (
        <li><a href={item.href} aria-current={isActive(item.enHref) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
    <a href={ctaHref} class="btn btn--primary">{T('nav.cta')}</a>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = header.querySelector<HTMLElement>('#mobile-menu')!;
  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    header.classList.toggle('is-open', open);
    menu.hidden = !open;
    document.documentElement.classList.toggle('menu-open', open);
  };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape') { setOpen(false); langSwitch?.removeAttribute('open'); } });
  const langSwitch = header.querySelector<HTMLDetailsElement>('[data-lang-switch]');
  document.addEventListener('click', (e) => { if (langSwitch?.open && !langSwitch.contains(e.target as Node)) langSwitch.open = false; });

  // Theme switch (light is the default; the choice is remembered).
  const root = document.documentElement;
  const themeBtn = header.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const themeMeta = document.querySelector<HTMLMetaElement>('[data-theme-color]');
  const applyTheme = (t: 'light' | 'dark') => {
    root.dataset.theme = t;
    themeBtn.setAttribute('aria-label', (t === 'dark' ? themeBtn.dataset.labelLight : themeBtn.dataset.labelDark) || '');
    themeBtn.setAttribute('aria-pressed', String(t === 'dark'));
    themeMeta?.setAttribute('content', t === 'dark' ? '#07061a' : '#f6f7fb');
    window.dispatchEvent(new CustomEvent('themechange', { detail: t }));
  };
  applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');
  themeBtn.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('lpt-theme', next); } catch {}
    applyTheme(next);
  });

  let ticking = false;
  addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      header.classList.toggle('is-scrolled', scrollY > 8);
      ticking = false;
    });
  }, { passive: true });
</script>
