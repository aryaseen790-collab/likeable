---
import type { Post } from '../lib/data';
import { categoryBySlug } from '../lib/data';
import { t, lpath, categoryName, formatDateIn, authorName, alternates, DEFAULT_LANG } from '../lib/i18n';
interface Props { post: Post; lang?: string; feature?: boolean; eager?: boolean }
const { post, lang = DEFAULT_LANG, feature = false, eager = false } = Astro.props;
const cat = categoryBySlug(post.categories[0]);
const catHref = cat && (alternates(cat.path).some((a) => a.lang.code === lang) ? lpath(lang, cat.path) : cat.path);
const img = post.featured;
---
<article class:list={['post-card', { 'post-card--feature': feature }]}>
  <a class="post-card__media" href={post.path} tabindex="-1" aria-hidden="true">
    {img && (
      <img
        src={img.sizes.medium_large ?? img.src}
        srcset={img.srcset}
        sizes={feature ? '(max-width: 820px) 100vw, 60vw' : '(max-width: 720px) 100vw, 420px'}
        width={img.width}
        height={img.height}
        alt={img.alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    )}
  </a>
  <div class="post-card__body">
    <div class="post-card__meta">
      {cat && <a href={catHref}>{lang === DEFAULT_LANG ? cat.name : categoryName(lang, cat.slug)}</a>}
      <time datetime={post.date}>{formatDateIn(lang, post.date)}</time>
    </div>
    <h2 class="post-card__title"><a href={post.path}>{post.title}</a></h2>
    <p class="post-card__excerpt">{post.excerpt.replace(/\s*(&#8230;|…|\[…\])\s*$/, '…')}</p>
    <span class="post-card__more">{t(lang, 'post.readArticle')} <span aria-hidden="true">→</span></span>
    <span class="sr-only">{t(lang, 'post.by')} {authorName(lang)}</span>
  </div>
</article>
