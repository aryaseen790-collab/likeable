---
import type { Post } from '../lib/data';
import { categoryBySlug, formatDate, site } from '../lib/data';
interface Props { post: Post; feature?: boolean; eager?: boolean }
const { post, feature = false, eager = false } = Astro.props;
const cat = categoryBySlug(post.categories[0]);
const img = post.featured;
---
<article class:list={['post-card', { 'post-card--feature': feature }]}>
  <a class="post-card__media" href={post.path} tabindex="-1" aria-hidden="true">
    {img && (
      <img
        src={img.sizes.medium_large ?? img.src}
        srcset={img.srcset}
        sizes={feature ? '(max-width: 820px) 100vw, 60vw' : '(max-width: 720px) 100vw, 420px'}
        width={img.width}
        height={img.height}
        alt={img.alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    )}
  </a>
  <div class="post-card__body">
    <div class="post-card__meta">
      {cat && <a href={cat.path}>{cat.name}</a>}
      <time datetime={post.date}>{formatDate(post.date)}</time>
    </div>
    <h2 class="post-card__title"><a href={post.path}>{post.title}</a></h2>
    <p class="post-card__excerpt">{post.excerpt.replace(/\s*(&#8230;|…|\[…\])\s*$/, '…')}</p>
    <span class="post-card__more">Read article <span aria-hidden="true">→</span></span>
    <span class="sr-only">By {site.author.name}</span>
  </div>
</article>
