---
// GA4 with Consent Mode v2: nothing is stored until the visitor accepts.
---
<div class="consent" role="dialog" aria-live="polite" aria-label="Cookie consent" hidden data-consent>
  <p>We use analytics cookies to understand how the test is used. See our <a href="/privacy-policy/">Privacy Policy</a>.</p>
  <div class="consent__actions">
    <button type="button" class="btn btn--ghost btn--sm" data-consent-choice="denied">Reject All</button>
    <button type="button" class="btn btn--primary btn--sm" data-consent-choice="granted">Accept All</button>
  </div>
</div>
<script>
  // Bundled (cached) instead of inlined into every page.
  const GA_ID = 'G-KZTXC78Q70';
  const w = window as unknown as { dataLayer: unknown[]; gtag: (...args: unknown[]) => void };
  w.dataLayer = w.dataLayer || [];
  w.gtag = function () {
    // gtag.js expects the Arguments object itself.
    // eslint-disable-next-line prefer-rest-params
    w.dataLayer.push(arguments);
  };
  const gtag = w.gtag;
  let stored: string | null = null;
  try {
    stored = localStorage.getItem('lpt-consent');
  } catch {}
  gtag('consent', 'default', {
    ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
    analytics_storage: stored === 'granted' ? 'granted' : 'denied',
  });
  gtag('js', new Date());
  gtag('config', GA_ID);

  // Load gtag.js on the first interaction so it never blocks the first paint.
  const evts = ['pointerdown', 'pointermove', 'touchstart', 'wheel', 'scroll', 'keydown'];
  const loadGa = () => {
    evts.forEach((e) => removeEventListener(e, loadGa));
    const s = document.createElement('script');
    s.async = true;
    s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
    document.head.appendChild(s);
  };
  evts.forEach((e) => addEventListener(e, loadGa, { passive: true }));

  const bar = document.querySelector<HTMLElement>('[data-consent]')!;
  if (!stored) {
    const reveal = () => {
      bar.hidden = false;
      removeEventListener('scroll', onScroll);
      clearTimeout(timer);
    };
    const onScroll = () => { if (scrollY > innerHeight * 0.6) reveal(); };
    const timer = setTimeout(reveal, 9000);
    addEventListener('scroll', onScroll, { passive: true });
  }
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const choice = t.closest<HTMLElement>('[data-consent-choice]');
    if (choice) {
      const v = choice.dataset.consentChoice!;
      try { localStorage.setItem('lpt-consent', v); } catch {}
      gtag('consent', 'update', { analytics_storage: v });
      bar.hidden = true;
    }
    if (t.closest('[data-consent-open]')) bar.hidden = false;
  });
</script>
