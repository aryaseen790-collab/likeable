---
// Right side of the homepage hero: a phone demonstrating how the test works (real
// app screens with captions that light up in step). The two ways to take the test
// are in HeroWays.astro. The phone is an image at first paint and
// becomes 3D (src/scripts/app-phone.ts) on the visitor's first interaction, like the
// homepage orbit, so it never competes with loading the page.
import { t, langOf, DEFAULT_LANG } from '../lib/i18n';
import { appRelease, megabytes, appScreen } from '../lib/app-release';
const { lang = DEFAULT_LANG } = Astro.props as { lang?: string };
const T = (k: string, v?: Record<string, string | number>) => t(lang, k, v);
const strip = (s: string) => s.replace(/<[^>]+>/g, '');
const rel = appRelease();
const size = rel ? Number(megabytes(rel.size)).toLocaleString(langOf(lang).tag, { maximumFractionDigits: 0 }) : '';
// Screens shown by the phone, and the caption for each.
const steps = [
  { screen: 2, title: T('how.s1title') },
  { screen: 3, title: T('how.s3title') },
  { screen: 4, title: strip(T('dims.title')) },
];
---
<div class="hero-demo" data-hero-demo>
  <p class="hero-demo__label">{T('how.eyebrow')}</p>
  <div class="hero-demo__stage" data-demo-stage aria-hidden="true">
    <div class="hero-demo__glow"></div>
    <div class="hero-demo__css">
      <div class="demo-phone">
        {steps.map((s, i) => (
          <img src={appScreen(lang, s.screen, true)} width="390" height="844" alt="" decoding="async" fetchpriority={i === 0 ? 'high' : 'low'} loading={i === 0 ? 'eager' : 'lazy'} class:list={[{ 'is-on': i === 0 }]} data-demo-img />
        ))}
      </div>
    </div>
    <canvas class="hero-demo__canvas" data-demo-canvas></canvas>
  </div>
  <!-- "Stories"-style steps: a bar per step fills while its screen plays. -->
  <ol class="hero-demo__steps" role="list">
    {steps.map((s, i) => (
      <li class:list={['hero-demo__step', { 'is-active': i === 0 }]} data-demo-step>
        <span class="hero-demo__bar" aria-hidden="true"><span></span></span>
        <span class="hero-demo__caption">
          <span class="hero-demo__n" aria-hidden="true">{(i + 1).toLocaleString(langOf(lang).tag)}</span>
          <span>{s.title}</span>
        </span>
      </li>
    ))}
  </ol>

</div>

<script>
  const demo = document.querySelector<HTMLElement>('[data-hero-demo]');
  if (demo) {
    const stage = demo.querySelector<HTMLElement>('[data-demo-stage]')!;
    const canvas = demo.querySelector<HTMLCanvasElement>('[data-demo-canvas]')!;
    const imgs = [...demo.querySelectorAll<HTMLImageElement>('[data-demo-img]')];
    const steps = [...demo.querySelectorAll<HTMLElement>('[data-demo-step]')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const show = (i: number) => {
      steps.forEach((s, j) => s.classList.toggle('is-active', j === i));
      imgs.forEach((img, j) => img.classList.toggle('is-on', j === i));
    };

    // Before 3D (and without WebGL): cycle the flat screenshots with the captions.
    let cycle = 0;
    let timer = 0;
    const startCycle = () => {
      if (reduced || timer) return;
      timer = window.setInterval(() => show((cycle = (cycle + 1) % steps.length)), 3200);
    };
    const visible = new IntersectionObserver(([e]) => (e.isIntersecting ? startCycle() : (clearInterval(timer), (timer = 0))));
    visible.observe(stage);

    // 3D on first interaction (Three.js is the same cached chunk as the orbit).
    const webgl = (() => {
      try {
        const c = document.createElement('canvas');
        return !!(c.getContext('webgl2') || c.getContext('webgl'));
      } catch {
        return false;
      }
    })();
    if (webgl && !reduced) {
      const events = ['pointerdown', 'pointermove', 'touchstart', 'wheel', 'scroll', 'keydown'];
      const go = () => {
        events.forEach((e) => removeEventListener(e, go));
        import('../scripts/app-phone').then(({ createPhone }) =>
          createPhone(canvas, {
            // Full-size versions of the screenshots (img.src is already the resolved URL).
            screens: imgs.map((img) => img.src.replace('-390.webp', '.webp')),
            hold: 3.2,
            ringRadius: 1.15,
            onReady: () => {
              demo.style.setProperty('--hold', '3.9s'); // hold + cross-fade in the 3D phone
              clearInterval(timer);
              visible.disconnect();
              stage.classList.add('is-3d');
            },
            onScreen: (i) => show(i),
          }),
        );
      };
      events.forEach((e) => addEventListener(e, go, { passive: true, once: true }));
    }

  }
</script>

<style>
  .hero-demo { --hold: 3.2s; display: flex; flex-direction: column; gap: 14px; margin-top: 6px; }
  .hero-demo__label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }

  /* The phone: the hero's main visual. */
  .hero-demo__stage { position: relative; width: 100%; height: clamp(340px, 46vh, 470px); }
  .hero-demo__glow { position: absolute; inset: 6% 14%; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--violet) 40%, transparent), transparent 70%); filter: blur(28px); }
  .hero-demo__css { position: absolute; inset: 0; display: grid; place-items: center; perspective: 1200px; transition: opacity 0.6s var(--ease); }
  .hero-demo__canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 0.8s var(--ease); }
  .hero-demo__stage.is-3d .hero-demo__canvas { opacity: 1; }
  .hero-demo__stage.is-3d .hero-demo__css { opacity: 0; }
  .demo-phone { position: relative; height: 94%; aspect-ratio: 390 / 844; padding: 7px; border-radius: 30px; background: linear-gradient(145deg, #2a2760, #12112e); box-shadow: 0 34px 70px -30px rgba(17, 21, 56, 0.6), inset 0 0 0 1px rgba(255, 255, 255, 0.12); transform: rotateY(-14deg) rotateX(4deg); animation: demo-float 6s ease-in-out infinite; }
  .demo-phone img { position: absolute; inset: 7px; width: calc(100% - 14px); height: calc(100% - 14px); object-fit: cover; border-radius: 23px; opacity: 0; transition: opacity 0.6s var(--ease); }
  .demo-phone img.is-on { opacity: 1; }
  @keyframes demo-float { 50% { transform: rotateY(-8deg) rotateX(3deg) translateY(-8px); } }

  /* Story-style steps under the phone. */
  .hero-demo__steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .hero-demo__bar { display: block; height: 4px; border-radius: 4px; background: var(--surface-3); overflow: hidden; }
  .hero-demo__bar span { display: block; height: 100%; width: 0; border-radius: inherit; background: var(--grad); }
  .hero-demo__step.is-active .hero-demo__bar span { animation: demo-fill var(--hold) linear forwards; }
  @keyframes demo-fill { to { width: 100%; } }
  .hero-demo__caption { display: flex; align-items: flex-start; gap: 8px; margin-top: 10px; color: var(--muted); font-weight: 600; font-size: 0.92rem; line-height: 1.3; transition: color 0.3s; }
  .hero-demo__n { flex: none; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; font-size: 0.75rem; background: var(--surface-3); color: var(--muted); transition: background 0.3s, color 0.3s; }
  .hero-demo__step.is-active .hero-demo__caption { color: var(--heading); }
  .hero-demo__step.is-active .hero-demo__n { background: var(--grad-on); color: #fff; }

  /* Phones and small tablets: a big phone with only the current step's caption under
     the progress bars. */
  @media (max-width: 900px) {
    /* Close to square: the 3D phone (framed to fit its emoji ring) then fills the height. */
    .hero-demo__stage { height: min(100vw - 24px, 480px, 64vh); }
    /* Bars stay in their three columns; the active caption spans the full width below. */
    .hero-demo__steps { position: relative; padding-bottom: 3.4em; }
    .hero-demo__caption { display: none; }
    .hero-demo__step.is-active .hero-demo__caption { display: flex; position: absolute; inset-inline: 0; top: 14px; justify-content: center; text-align: center; font-size: 1.02rem; }
  }
  /* Desktop: a tall phone on the left; steps (as a vertical progress list) and the two
     ways to take the test beside it, so the phone fills its space instead of floating. */
  /* Desktop: a tall phone with the steps (a vertical progress list) beside it. */
  @media (min-width: 901px) {
    .hero-demo { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); grid-template-areas: 'label label' 'stage steps'; column-gap: clamp(16px, 2.2vw, 28px); row-gap: 10px; }
    .hero-demo__label { grid-area: label; }
    .hero-demo__stage { grid-area: stage; height: clamp(420px, calc(100vh - 210px), 580px); }
    .hero-demo__steps { grid-area: steps; align-self: center; grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .hero-demo__step { padding: 10px 14px 12px; border-radius: 14px; border: 1px solid transparent; transition: background-color 0.3s, border-color 0.3s; }
    .hero-demo__step.is-active { background: var(--surface); border-color: var(--border); box-shadow: var(--shadow-sm); }
    .hero-demo__caption { margin-top: 8px; font-size: 0.98rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo-phone { animation: none; }
    .hero-demo__step.is-active .hero-demo__bar span { animation: none; width: 100%; }
  }
</style>
