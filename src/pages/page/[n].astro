---
// WordPress paginates the home page's post loop at /page/N/.
import Archive from '../../components/Archive.astro';
import { posts, site, paginate } from '../../lib/data';
export function getStaticPaths() {
  return paginate(posts, site.homePerPage).slice(1).map((p) => ({ params: { n: String(p.page) }, props: p }));
}
const { page, total, items } = Astro.props;
---
<Archive path={`/page/${page}/`} eyebrow={`Page ${page}`} title="Our <em>Blog</em>" items={items} page={page} total={total} base="" />
