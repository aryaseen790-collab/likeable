---
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import PostCard from '../components/PostCard.astro';
import { home, posts, site, dimensions, paginate } from '../lib/data';

const byCls = (cls: string) => home.sections.find((s) => s.cls === cls)!;
const contentSections = ['lpt-what-section', 'lpt-likable-section', 'lpt-social-section', 'lpt-unlikable-section', 'lpt-personality-section', 'lpt-popular-section', 'lpt-tips-section'].map(byCls);
const faq = byCls('lpt-faq-section');
const cta = byCls('lpt-cta-section');
const dims = dimensions();
const colors = ['#38d6ff', '#5b84ff', '#fbbf24', '#f472b6', '#a78bfa', '#34d399', '#60a5fa', '#f76a0c', '#e879f9'];
const [blogPage] = paginate(posts, site.homePerPage);

const steps = [
  { n: '01', title: 'Answer 25 questions', text: 'Quick, honest answers about how you greet, listen, help and follow through. No sign-up, no email.' },
  { n: '02', title: 'Watch your orbit form', text: 'Each answer pulls one of nine dimensions toward your core. Your shape builds in real time.' },
  { n: '03', title: 'Get your breakdown', text: 'An instant overall score, nine category scores, your top strength, your focus area and a free report.' },
];
---
<Base path="/" schema={home.schema} bodyClass="home">
  <canvas class="orbit-canvas" data-orbit aria-hidden="true"></canvas>
  <div class="orbit-fallback" aria-hidden="true"><span></span></div>

  <!-- HERO -->
  <section class="hero" data-hero>
    <div class="hero__inner container">
      <div class="hero__content">
        <div class="chip hero__badge" data-hero-in><span class="chip-dot"></span>Free · 5 Minutes · 25 Questions</div>
        <h1 class="display hero__title" data-hero-in>The Free Likeable Person Test — <em>Am I Likeable?</em></h1>
        <p class="lead hero__sub" data-hero-in>Take our research-backed likability test to discover your social strengths, blind spots, and the specific traits that shape how others see you — with a detailed breakdown across 9 key dimensions. Find out exactly how likeable you are in just 5 minutes.</p>
        <div class="hero__ctas" data-hero-in>
          <a href="/#take-test" class="btn btn--primary btn--lg" data-magnetic>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>Take the Free Likeable Person Test
          </a>
          <a href="/#what-makes" class="btn btn--ghost btn--lg">Learn more <span aria-hidden="true">→</span></a>
        </div>
        <dl class="hero__stats" data-hero-in>
          <div><dt>Questions</dt><dd><span data-count="25">25</span></dd></div>
          <div><dt>Categories</dt><dd><span data-count="9">9</span></dd></div>
          <div><dt>Average time</dt><dd><span data-count="5">5</span> min</dd></div>
        </dl>
      </div>
    </div>
    <a href="#how" class="hero__scroll" aria-label="Scroll to how it works"><span></span></a>
  </section>

  <!-- HOW IT WORKS: 3D drop scroll -->
  <section class="drop-section" id="how" data-drop>
    <div class="drop-section__pin">
      <div class="container drop-section__head">
        <span class="eyebrow">How it works</span>
        <h2 class="h2">Five minutes. <em>Nine dimensions.</em> One clear picture.</h2>
      </div>
      <div class="drop-stage container" data-drop-stage>
        {steps.map((s, i) => (
          <article class="drop-card glass" data-drop-card style={`--i:${i}`}>
            <span class="drop-card__n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- THE TEST -->
  <section class="quiz-section" id="take-test" data-quiz-section>
    <div class="container">
      <header class="quiz-section__head" data-reveal>
        <div class="lpt-section-label">The Test</div>
        <h2 class="lpt-section-title">Free Likeable Person Test — <em>Your Likability Assessment</em></h2>
        <p class="lead">Answer all 25 questions honestly to find out how likeable you are. Results are instant and completely private — no login required. This likable person test is 100% free.</p>
      </header>

      <div class="quiz glass" data-quiz data-state="start" data-no-reveal>
        <div class="quiz__bar">
          <h2 class="quiz__title">Free Likeable Person Test Online</h2>
          <p>Take the free likability test and discover how likeable you really are. Answer honestly for accurate results.</p>
        </div>

        <div class="quiz__start" data-step="start">
          <p class="quiz__start-hook">Ready to find out "am I a likeable person?"</p>
          <p class="quiz__start-desc">This likeability test will assess your social skills, empathy, and interpersonal traits. Answer 25 questions honestly to discover your likability score and get a full personality breakdown!</p>
          <div class="quiz__start-actions">
            <button type="button" class="btn btn--primary btn--lg" data-action="start" data-magnetic>Start the Likeable Person Test</button>
            <button type="button" class="btn btn--ghost" data-action="resume" data-resume hidden>Resume</button>
          </div>
          <ul class="quiz__perks">
            <li>🔒 Private — answers never leave your device</li>
            <li>⌨️ Keys 1–4 to answer, ← → to move</li>
            <li>📄 Free downloadable report</li>
          </ul>
        </div>

        <div class="quiz__run" data-step="run" hidden>
          <div class="quiz__top">
            <div class="quiz__ring" data-ring aria-hidden="true"><svg viewBox="0 0 44 44"><circle cx="22" cy="22" r="19" /><circle cx="22" cy="22" r="19" /></svg></div>
            <p class="quiz__count"><b data-current>1</b> of <span data-total>25</span></p>
            <span class="quiz__cat" data-cat></span>
          </div>
          <div class="quiz__card" data-card aria-live="polite">
            <p class="quiz__hook" data-hook></p>
            <h3 class="quiz__q" id="quiz-q" data-q></h3>
            <div class="quiz__options" role="radiogroup" aria-labelledby="quiz-q" data-options></div>
          </div>
          <div class="quiz__nav">
            <button type="button" class="btn btn--ghost btn--sm" data-action="prev" data-prev>Previous</button>
            <ol class="quiz__dims" data-dims aria-hidden="true"></ol>
            <button type="button" class="btn btn--primary btn--sm" data-action="next" data-next>Next</button>
          </div>
        </div>

        <div class="quiz__result" data-step="result" hidden>
          <p class="quiz__shared">You're viewing a shared result. <button type="button" class="linklike" data-action="retry">Take the test yourself →</button></p>
          <h2 class="quiz__result-title">Your Likability Test Results</h2>
          <div class="result-hero">
            <div class="score-ring" data-score-ring>
              <svg viewBox="0 0 120 120" aria-hidden="true"><defs><linearGradient id="scoreGrad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#38d6ff" /><stop offset=".5" stop-color="#8b5cf6" /><stop offset="1" stop-color="#ff9a4d" /></linearGradient></defs><circle cx="60" cy="60" r="52" /><circle cx="60" cy="60" r="52" /></svg>
              <div class="score-ring__value"><span data-overall>0%</span><small data-label></small></div>
            </div>
            <div class="result-hero__text">
              <div class="lpt-overall-feedback" data-feedback></div>
              <div class="result-highlights">
                <div class="result-highlight result-highlight--top"><span>Top strength</span><p data-strength></p></div>
                <div class="result-highlight result-highlight--focus"><span>Focus area</span><p data-focus></p></div>
              </div>
            </div>
          </div>
          <div class="result-body">
            <div class="radar" data-radar></div>
            <div class="lpt-categories-grid" data-grid></div>
          </div>
          <div class="lpt-action-buttons">
            <button type="button" class="btn btn--primary" data-action="share">↗ Share my result</button>
            <button type="button" class="btn btn--ghost" data-action="copy">🔗 Copy link</button>
            <button type="button" class="btn btn--ghost" data-action="download">📥 Download Report</button>
            <button type="button" class="btn btn--ghost" data-action="retry">🔄 Take the Test Again</button>
          </div>
          <p class="quiz__share-msg" data-share-msg role="status"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- NINE DIMENSIONS: horizontal pinned track -->
  <section class="dims-section" data-dims-section>
    <div class="dims-section__pin">
      <div class="container dims-section__head">
        <span class="eyebrow">What the test measures</span>
        <h2 class="h2">The 9 dimensions of <em>likeability</em></h2>
      </div>
      <div class="dims-track" data-dims-track>
        {dims.map((d, i) => (
          <article class="dim-card" style={`--c:${colors[i]}`} data-tilt>
            <span class="dim-card__orb" aria-hidden="true"></span>
            <span class="dim-card__icon" aria-hidden="true">{d.icon}</span>
            <h3>{d.name.replace(/^\d+\.\s*/, '')}</h3>
            <p>{d.desc}</p>
            <span class="dim-card__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </article>
        ))}
        <a class="dim-card dim-card--cta" href="/complete-guide/">
          <span class="dim-card__icon" aria-hidden="true">📘</span>
          <h3>Read the Complete Guide</h3>
          <p>The science behind every dimension, and how to read your score.</p>
          <span class="dim-card__n" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ORIGINAL CONTENT SECTIONS -->
  <div class="home-content">
    {contentSections.map((s) => <Fragment set:html={s.html} />)}
  </div>

  <!-- BLOG -->
  <section class="section home-blog">
    <div class="container">
      <div class="home-blog__head" data-reveal>
        <div>
          <span class="eyebrow">Read &amp; improve</span>
          <h2 class="h2">{home.blog.heading || 'Our Blog'}</h2>
        </div>
        <a class="btn btn--ghost" href="/blog/">All articles →</a>
      </div>
      <div class="post-grid">
        {blogPage.items.map((p, i) => <PostCard post={p} feature={i === 0} />)}
      </div>
      {blogPage.total > 1 && (
        <nav class="pagination" aria-label="Posts pagination">
          <span aria-current="page">1</span>
          {Array.from({ length: blogPage.total - 1 }, (_, i) => i + 2).map((n) => <a href={`/page/${n}/`}>{n}</a>)}
          <a href="/page/2/" rel="next">Next →</a>
        </nav>
      )}
    </div>
  </section>

  <Fragment set:html={faq.html} />
  <Fragment set:html={cta.html} />

  <script>
    import { initHome } from '../scripts/home';
    initHome();
  </script>
</Base>
