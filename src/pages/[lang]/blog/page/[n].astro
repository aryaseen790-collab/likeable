---
import Archive from '../../../../components/Archive.astro';
import { site, paginate } from '../../../../lib/data';
import { liveLangs, postsIn, t, lpath, DEFAULT_LANG } from '../../../../lib/i18n';
export function getStaticPaths() {
  return liveLangs()
    .filter((l) => l.code !== DEFAULT_LANG)
    .flatMap((l) => paginate(postsIn(l.code), site.blogPerPage).slice(1).map((p) => ({ params: { lang: l.code, n: String(p.page) }, props: p })));
}
const { lang } = Astro.params as { lang: string };
const { page, total, items } = Astro.props;
---
<Archive path={lpath(lang, `/blog/page/${page}/`)} enPath={`/blog/page/${page}/`} lang={lang} eyebrow={`${t(lang, 'blog.heading')} · ${t(lang, 'blog.page', { n: page })}`} title={t(lang, 'blog.title')} metaTitle={`${t(lang, 'meta.blogTitle')} - ${t(lang, 'blog.page', { n: page })}`} intro={t(lang, 'blog.intro')} items={items} page={page} total={total} base="/blog" />
