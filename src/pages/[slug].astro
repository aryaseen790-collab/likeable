---
import PostView from '../components/views/PostView.astro';
import { posts } from '../lib/data';
import { postIn, pageIn } from '../lib/i18n';

export function getStaticPaths() {
  return [...posts.map((p) => ({ params: { slug: p.slug } })), ...['privacy-policy', 'terms-conditions'].map((slug) => ({ params: { slug } }))];
}
const { slug } = Astro.params as { slug: string };
const post = postIn('en', slug) ?? undefined;
const page = post ? undefined : pageIn('en', slug)!;
---
<PostView lang="en" enPath={`/${slug}/`} post={post} page={page} schema={post?.schema ?? []} />
