---
import '@fontsource/dm-serif-display/latin-400.css';
import '@fontsource/dm-serif-display/latin-400-italic.css';
import '@fontsource-variable/work-sans/wght.css';
import '../styles/global.css';
import workSansUrl from '@fontsource-variable/work-sans/files/work-sans-latin-wght-normal.woff2?url';
import dmSerifUrl from '@fontsource/dm-serif-display/files/dm-serif-display-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import { seo as seoMap, site } from '../lib/data';

interface Props {
  path: string;
  title?: string;
  description?: string;
  schema?: string[];
  bodyClass?: string;
  noindex?: boolean;
}
const { path, title, description, schema = [], bodyClass = '', noindex = false } = Astro.props;
const seo = seoMap[path];
const pageTitle = seo?.title ?? title ?? site.name;
const meta = seo?.meta ?? [
  ...(description ? [{ name: 'description', content: description }] : []),
  { property: 'og:title', content: pageTitle },
  { property: 'og:site_name', content: site.name },
  { property: 'og:image', content: `${site.origin}${site.logo.src}` },
  { name: 'twitter:card', content: 'summary_large_image' },
];
const canonical = seo?.canonical ?? new URL(path, site.origin).href;
const jsonld = [...(seo?.jsonld ?? []), ...schema];
---
<!doctype html>
<html lang="en-US" dir="ltr" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Theme before first paint (light by default).
      (function () {
        var t = 'light';
        try { t = localStorage.getItem('lpt-theme') || 'light'; } catch (e) {}
        document.documentElement.dataset.theme = t === 'dark' ? 'dark' : 'light';
      })();
    </script>
    <link rel="preload" href={workSansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={dmSerifUrl} as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    {meta.map((m) => ('name' in m ? <meta name={m.name} content={m.content} /> : <meta property={m.property} content={m.content} />))}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {seo?.prev && <link rel="prev" href={seo.prev} />}
    {seo?.next && <link rel="next" href={seo.next} />}
    <meta name="theme-color" content="#f6f7fb" data-theme-color />
    <meta name="color-scheme" content="light dark" />
    {site.icons.map((i) => <link rel={i.rel} href={i.href} sizes={i.sizes ?? undefined} />)}
    <link rel="alternate" type="application/rss+xml" title={`${site.name} » Feed`} href="/rss.xml" />
    {jsonld.map((j) => <script type="application/ld+json" is:inline set:html={j} />)}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-glow" aria-hidden="true"></div>
    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Consent />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
