---
import '@fontsource/dm-serif-display/latin-400.css';
import '@fontsource/dm-serif-display/latin-400-italic.css';
import '@fontsource-variable/work-sans/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import { seo as seoMap, site } from '../lib/data';

interface Props {
  path: string;
  title?: string;
  description?: string;
  schema?: string[];
  bodyClass?: string;
  noindex?: boolean;
}
const { path, title, description, schema = [], bodyClass = '', noindex = false } = Astro.props;
const seo = seoMap[path];
const pageTitle = seo?.title ?? title ?? site.name;
const meta = seo?.meta ?? [
  ...(description ? [{ name: 'description', content: description }] : []),
  { property: 'og:title', content: pageTitle },
  { property: 'og:site_name', content: site.name },
  { property: 'og:image', content: `${site.origin}${site.logo.src}` },
  { name: 'twitter:card', content: 'summary_large_image' },
];
const canonical = seo?.canonical ?? new URL(path, site.origin).href;
const jsonld = [...(seo?.jsonld ?? []), ...schema];
---
<!doctype html>
<html lang="en-US" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Hide reveal targets before first paint; restore them if the motion bundle never runs.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-motion');
        setTimeout(function () { if (!window.__motionReady) document.documentElement.classList.remove('js-motion'); }, 3500);
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    {meta.map((m) => ('name' in m ? <meta name={m.name} content={m.content} /> : <meta property={m.property} content={m.content} />))}
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {seo?.prev && <link rel="prev" href={seo.prev} />}
    {seo?.next && <link rel="next" href={seo.next} />}
    <meta name="theme-color" content="#06051a" />
    <meta name="color-scheme" content="dark" />
    {site.icons.map((i) => <link rel={i.rel} href={i.href} sizes={i.sizes ?? undefined} />)}
    <link rel="alternate" type="application/rss+xml" title={`${site.name} » Feed`} href="/rss.xml" />
    {jsonld.map((j) => <script type="application/ld+json" is:inline set:html={j} />)}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="bg-cosmos" aria-hidden="true"><div class="bg-grid"></div><div class="bg-glow bg-glow-a"></div><div class="bg-glow bg-glow-b"></div></div>
    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <Header path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Consent />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
